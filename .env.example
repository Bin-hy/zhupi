# 复制为 .env 后修改（服务不自动读取 .env，请由 Compose/systemd 注入）

ADDR=:8080
DB_PATH=./zhupi.db
# 对外访问地址，用于拼接 OAuth/OIDC 回调
PUBLIC_BASE_URL=https://zhupi.dev

# 32 字节密钥（hex 或 base64）：openssl rand -hex 32
SECRET_KEY=change-me
SESSION_TTL_HOURS=720

# 全站 GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 本地管理员引导账号（首次启动自动创建）
# 默认 admin/admin，首次登录强制改密；后续管理员请在后台「管理员账号」创建
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin
# 设为 1 时，下次启动用上面的密码重置该本地管理员并吊销其全部会话
LOCAL_ADMIN_RESET_PASSWORD=0

# 允许跨域访问管理 API 的来源（未来管理后台用；留空即关闭）
ADMIN_ORIGINS=

# 反向代理后设为 1
TRUST_PROXY=1
# 仅本地测试：允许缺少 Origin 的站点级请求
ALLOW_MISSING_ORIGIN=0
# 仅本地开发：开放 /api/v1/auth/dev/login
DEV_LOGIN=0

# 限流（每分钟）
READ_RATE_PER_MIN=300
WRITE_RATE_PER_MIN=60
WRITE_USER_RATE_PER_MIN=30
LOCAL_LOGIN_RATE_PER_MIN=10
