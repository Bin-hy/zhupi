# 复制为 .env 后修改（服务不自动读取 .env，请由 Compose/systemd 注入）

ADDR=:8080
DB_PATH=./annotations.db
# 对外访问地址，用于拼接 OAuth/OIDC 回调
PUBLIC_BASE_URL=https://annot.example.com

# 32 字节密钥（hex 或 base64）：openssl rand -hex 32
SECRET_KEY=change-me
SESSION_TTL_HOURS=720

# 全站 GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 命中这些 GitHub 登录名的用户，登录后自动成为超级管理员
SUPERADMIN_GITHUB_LOGINS=

# 允许跨域访问管理 API 的来源（未来管理后台用；留空即关闭）
ADMIN_ORIGINS=

# 反向代理后设为 1
TRUST_PROXY=1
# 仅本地测试：允许缺少 Origin 的站点级请求
ALLOW_MISSING_ORIGIN=0
# 仅本地开发：开放 /api/v1/auth/dev/login
DEV_LOGIN=0

# 限流（每分钟）
READ_RATE_PER_MIN=300
WRITE_RATE_PER_MIN=60
WRITE_USER_RATE_PER_MIN=30
