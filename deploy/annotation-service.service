# 裸机部署（不用 Docker）时的 systemd 单元示例
#
#   sudo cp annotation-service /opt/annotation-service/annotation-service
#   sudo cp deploy/annotation-service.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now annotation-service
#
# 环境变量写在 /etc/annotation-service.env（参考 .env.example），DB_PATH 指向
# /var/lib/annotation-service/annotations.db。

[Unit]
Description=GoCampus annotation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=annotation
Group=annotation
WorkingDirectory=/opt/annotation-service
EnvironmentFile=/etc/annotation-service.env
ExecStart=/opt/annotation-service/annotation-service
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/annotation-service

[Install]
WantedBy=multi-user.target
