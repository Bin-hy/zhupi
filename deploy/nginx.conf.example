# 宿主机 Nginx 配置示例（放在 /etc/nginx/conf.d/zhupi.conf）
#
# 前提：已有证书。可用 certbot 申请：
#   certbot certonly --nginx -d zhupi.dev
# 然后执行 nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name zhupi.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name zhupi.dev;

    ssl_certificate     /etc/letsencrypt/live/zhupi.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zhupi.dev/privkey.pem;

    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
